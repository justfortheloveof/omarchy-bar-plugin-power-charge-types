#!/usr/bin/env bash
# Local check: everything CI runs, plus `omarchy plugin validate` and
# `tools/sync-upstream --check`, which need an Omarchy box or an upstream
# mirror. Any failing stage aborts with a non-zero exit, and skipped stages are
# listed, so a pending tree is never reported as "all green".
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

skips=()

skip() {
	printf 'skip: %s\n' "$1"
	skips+=("$1")
}

# ---------------------------------------------------------------------------
# CI-equivalent stages (must run anywhere, no cwd dependence).
# ---------------------------------------------------------------------------
# One file per invocation: `bash -n a b c` parses a and treats b and c as
# arguments to it, so only the first would ever be checked.
for script in bin/lenovo-power-conservation install.sh uninstall.sh tools/sync-upstream bin/check bin/check-agent-files; do
	bash -n "$script"
done
bin/check-agent-files "$root"
python3 -c 'import json; json.load(open("manifest.json"))'
node --test tests/conservation.test.cjs tests/helper.test.cjs

# ---------------------------------------------------------------------------
# Fork markers must balance: every `lenovo-conservation: start` its `end`,
# no `end` unmet. Comment-only, so it runs in CI too.
# ---------------------------------------------------------------------------
for f in Panel.qml Model.js Conservation.js; do
	awk '
		/lenovo-conservation: start/ { depth++; next }
		/lenovo-conservation: end/ {
			if (depth == 0) {
				printf "  %s:%d: end marker with no matching start\n", FILENAME, FNR > "/dev/stderr"
				bad = 1
			}
			depth--
		}
	 END {
		if (depth != 0) {
			printf "%s: %d start marker(s) without an end\n", FILENAME, depth > "/dev/stderr"
			bad = 1
		}
		exit bad
	}' "$f" || exit 1
done
echo "fork markers: balanced"

# ---------------------------------------------------------------------------
# Where this fork sits against upstream. Never gates: there is nothing to fail,
# it is only ever information.
# ---------------------------------------------------------------------------
if [ -x tools/sync-upstream ]; then
	echo
	tools/sync-upstream --check || true
fi

# ---------------------------------------------------------------------------
# Model.js must stay byte-identical to upstream: the README calls it unchanged,
# any edit here can conflict on the next sync, and upstream tests it in
# test/shell.d/power-test.sh, so churn there is noise for them too.
# ---------------------------------------------------------------------------
pinned=$(sed -n 's/^sha=//p' upstream.lock)
mirror=${OMARCHY_UPSTREAM_MIRROR:-${TMPDIR:-/tmp}/omarchy-power-lenovo-battery-conservation-upstream.git}
upstream_path=shell/plugins/panels/power

if [ -d "$mirror" ] && git --git-dir="$mirror" cat-file -e "${pinned}^{commit}" 2>/dev/null; then
	if git --git-dir="$mirror" show "${pinned}:${upstream_path}/Model.js" | diff -q - Model.js >/dev/null; then
		echo "Model.js: identical to upstream $pinned"
	else
		echo "Model.js has diverged from upstream ${pinned}." >&2
		echo "It should not: the README calls it unchanged, and any edit there" >&2
		echo "is a line that can conflict on the next sync." >&2
		exit 1
	fi
else
	skip "no upstream mirror at $mirror - not comparing Model.js (tools/sync-upstream failed to fetch one)"
fi

# ---------------------------------------------------------------------------
# Every line this fork has added to Panel.qml must be marked: inside a fence,
# or a tail marker on a line upstream owns. Needs the mirror, like the stage
# above.
# ---------------------------------------------------------------------------
if [ -d "$mirror" ] && git --git-dir="$mirror" cat-file -e "${pinned}^{commit}" 2>/dev/null; then
	unmarked=$(awk '
		/^@@ / {
			if (match($0, /\+[0-9]+(,[0-9]+)?/)) {
				range = substr($0, RSTART + 1, RLENGTH - 1)
				if ((c = index(range, ",")) > 0) n = substr(range, 1, c - 1) + 0
				else n = range + 0
			} else n = 0
			in_hunk = 1
			next
		}
		/^--- / || /^\+\+\+ / { in_hunk = 0; next }
		!in_hunk { next }
		/^\+/ {
			line = substr($0, 2)
			# Blank lines are formatting, not content.
			if (line ~ /^[[:space:]]*$/) { n++; next }
			covered = 0
			if (line ~ /lenovo-conservation: start ----[[:space:]]*$/) { open_at = n; covered = 1 }
			else if (line ~ /lenovo-conservation: end ----[[:space:]]*$/) { open_at = 0; covered = 1 }
			else if (open_at > 0) covered = 1
			else if (line ~ /[[:space:]]\/\/ lenovo-conservation[[:space:]]*$/) covered = 1
			if (!covered) { printf "  Panel.qml:%d: %s\n", n, line; bad = 1 }
			n++
			next
		}
		/^ / { n++ }
		END { exit bad }
	' <(git --git-dir="$mirror" show "${pinned}:${upstream_path}/Panel.qml" | diff -u - Panel.qml)) || true
	# awk exits 1 when it has found an unmarked line: the report, not a failure.
	if [ -n "$unmarked" ]; then
		echo "Panel.qml has fork changes that carry no marker:" >&2
		printf '%s\n' "$unmarked" >&2
		echo "Fence the block, or tail-mark an edited line, the way every other" >&2
		echo "change in the file is marked - see docs/CONTRIBUTING.md." >&2
		exit 1
	fi
	echo "Panel.qml: every forked line is fenced or tail-marked"
else
	skip "no upstream mirror at $mirror - not checking Panel.qml marker coverage (tools/sync-upstream failed to fetch one)"
fi

# ---------------------------------------------------------------------------
# Panel.qml against the shell API this machine actually has. A cloned
# first-party panel is not self-contained, it imports types and singleton members
# the shell provides, so a Panel.qml from a newer omarchy can reference API this
# machine lacks - and the symptom is a widget that silently fails to load.
# ---------------------------------------------------------------------------
SHELL_DIR=/usr/share/omarchy/shell

# Qt does not link qmllint into /usr/bin, so `command -v qmllint` finds nothing
# on a box where it is installed. Look where Qt actually puts it, then fall back
# to PATH. Same two directories the CI workflow probes, so both agree.
qmllint_cmd=
for candidate in /usr/lib/qt6/bin/qmllint /usr/lib/x86_64-linux-gnu/qt6/bin/qmllint; do
	if [ -x "$candidate" ]; then
		qmllint_cmd=$candidate
		break
	fi
done
if [ -z "$qmllint_cmd" ]; then
	qmllint_cmd=$(command -v qmllint || true)
fi

if [ ! -d "$SHELL_DIR" ]; then
	skip "no $SHELL_DIR - not checking Style members or Panel.qml type resolution (off-box)"
else
	# Stage 1: Style members. qmllint structurally cannot catch these: Style
	# resolves, so a missing member looks like the same missing-property noise it
	# reports for unresolved components. Check the source instead. Needs only
	# $SHELL_DIR, which is why it is not bundled with the qmllint run below.
	missing_style=""
	for member in $(grep -oE '\bStyle\.[a-zA-Z_][a-zA-Z0-9_]*' Panel.qml | sed 's/^Style\.//' | sort -u); do
		grep -qE "(property|readonly property|function)[[:space:]].*\b$member\b" "$SHELL_DIR/Commons/Style.qml" ||
			missing_style="$missing_style $member"
	done
	if [ -n "$missing_style" ]; then
		echo "Panel.qml uses Style member(s) this omarchy's Style.qml does not define:$missing_style" >&2
		exit 1
	fi
	echo "Panel.qml: every Style member resolves against $SHELL_DIR"

	if [ -z "$qmllint_cmd" ]; then
		skip "qmllint not on PATH or in /usr/lib/qt6/bin - not checking Panel.qml type resolution"
	else
		# qs -> <shell dir> so `import qs.Commons` resolves, the way the running
		# shell resolves it.
		qsimport=$(mktemp -d)
		ln -s "$SHELL_DIR" "$qsimport/qs"

		# Stage 2: type resolution. qmllint reports an unresolvable type as
		#    "X was not found"; that is the check that catches a panel referencing
		#    shell API newer than the install. signal-handler-parameters is excluded
		#    because upstream's own file produces it (QProcess::ExitStatus).
		lint_output=$("$qmllint_cmd" -I "$qsimport" Panel.qml 2>&1) && lint_status=0 || lint_status=$?

		unresolved=$(grep 'was not found' <<<"$lint_output" | grep -v '\[signal-handler-parameters\]' || true)
		if [ -n "$unresolved" ]; then
			echo "Panel.qml references shell API this omarchy does not have:" >&2
			echo "$unresolved" | sed 's/^/  /' >&2
			echo "Either update omarchy, or re-pin upstream.lock to the installed" >&2
			echo "version and re-run tools/sync-upstream." >&2
			rm -rf "$qsimport"
			exit 1
		fi

		if [ "$lint_status" -ne 0 ]; then
			echo "Panel.qml does not parse (qmllint exit $lint_status):" >&2
			grep -B1 -A3 '\[syntax\]' <<<"$lint_output" >&2 || echo "$lint_output" >&2
			rm -rf "$qsimport"
			exit 1
		fi

		rm -rf "$qsimport"
		echo "Panel.qml: parses, and every type resolves against $SHELL_DIR"
	fi
fi

# ---------------------------------------------------------------------------
# Manifest validation against the marketplace schema.
# ---------------------------------------------------------------------------
if command -v omarchy >/dev/null 2>&1 && [ -d /usr/share/omarchy ]; then
	omarchy plugin validate "$root"
else
	skip "omarchy not found - not validating the manifest (local machine only)"
fi

# ---------------------------------------------------------------------------
# Summary. A truly green run means zero skips.
# ---------------------------------------------------------------------------
if [ ${#skips[@]} -ne 0 ]; then
	printf 'bin/check: green with %d skip(s):\n' "${#skips[@]}"
	printf '  %s\n' "${skips[@]}"
else
	echo "bin/check: all green"
fi
