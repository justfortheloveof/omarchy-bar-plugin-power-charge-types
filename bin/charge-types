#!/bin/bash
#
# charge-types: read or set the battery's charge type.
#
# The charge_types protocol: `list`, `status`, and `set`.
#
# Source:   https://github.com/justfortheloveof/omarchy-bar-plugin-power-charge-types
# License:  MIT, the same terms as Omarchy itself.
# Installed by install.sh from that repository. Removed by uninstall.sh from the
# same repository, or by deleting the file, since it keeps no state.
#
# The only part of the plugin that runs as root, and the installed copy is the
# only thing the plugin asks to be elevated.
#
# The trust boundary: it takes no path from its caller - it resolves the kernel
# attribute itself, from the glob fixed below - and it will write only values
# it just read from the attribute's own list. Nothing re-executes itself
# either, `set` requiring root already, so a copy in a user-writable directory
# cannot elevate itself.
#
# Usage:
#   charge-types list
#   charge-types status
#   pkexec /usr/local/libexec/io.github.justfortheloveof.power-charge-types/charge-types set <type>

set -euo pipefail

# Marker used by uninstall.sh to confirm the file it is about to remove really
# is ours and not something else that happens to sit at this path.
readonly MARKER='charge-types: installed by the omarchy power-charge-types plugin'

# The installed copy, named only for error messages. Never used to run anything.
readonly PACKAGED_PATH=/usr/local/libexec/io.github.justfortheloveof.power-charge-types/charge-types

# The power-supply class. Fixed here, never assembled from caller input. The
# charge_types attribute (kernel >= 6.14) sits in each supply's directory.
readonly SUPPLY_GLOB='/sys/class/power_supply/*'

# Distinct exit codes so a caller can tell the cases apart without parsing text.
readonly EXIT_OK=0
readonly EXIT_ERROR=1
readonly EXIT_USAGE=2
readonly EXIT_UNSUPPORTED=3
readonly EXIT_UNKNOWN=4

# pkexec sanitises the environment, but pin PATH and the locale anyway so a
# direct root invocation cannot resolve a helper out of a writable directory, and
# so validation does not shift with an inherited locale. Same as omarchy-dns.
if ((EUID == 0)); then
	export PATH=/usr/sbin:/usr/bin:/sbin:/bin
	export LC_ALL=C.UTF-8
fi

die() {
	printf '%s: %s\n' "${0##*/}" "$1" >&2
	exit "$2"
}

# Print the name of the bracketed entry of a charge_types read, or fail if the
# read does not contain exactly one.
active_name() {
	local raw=$1 name count=0 active=

	# Intentional word splitting: the attribute's whitespace-separated entries.
	# shellcheck disable=SC2086
	for name in $raw; do
		if [[ $name == \[*\] ]]; then
			count=$((count + 1))
			active=${name:1:${#name} - 2}
		fi
	done

	((count == 1)) || return 1
	printf '%s\n' "$active"
}

# Globals filled by attr_path: the resolved attribute, its just-read contents,
# and the failure word to report when nothing qualifies.
ATTR_PATH=
ATTR_RAW=
REJECT_WORD=unsupported

# Resolve the charge_types attribute we act on, or fail with REJECT_WORD set.
#
# A candidate supply counts only if all of these hold (ADR 0001):
#   1. its `type` file reads exactly "Battery" - stock mainline puts
#      charge_types on *every* supply, AC adapters included, so file
#      existence alone is not detection;
#   2. its `charge_types` file exists and reads successfully;
#   3. the read output contains exactly one bracketed active entry.
#
# The first qualifying supply in lexical glob order wins (dual-battery
# machines: BAT0 before BAT1). When none qualifies, REJECT_WORD keeps the
# failure words apart: "unsupported" when no readable battery exists at all,
# "unknown" when a battery reads back a list with no single active entry.
attr_path() {
	local path type raw saw_readable_battery=0

	# Intentional word splitting: SUPPLY_GLOB is a glob.
	# shellcheck disable=SC2086
	for path in $SUPPLY_GLOB; do
		[[ -d $path ]] || continue

		type=$(cat -- "$path/type" 2>/dev/null) || continue
		[[ $type == Battery ]] || continue

		# Existence and readability collapse into the read attempt: a missing
		# or unreadable attribute makes cat fail, and a directory makes it fail
		# too, so a failed read is the whole of the check.
		raw=$(cat -- "$path/charge_types" 2>/dev/null) || continue

		saw_readable_battery=1
		if active_name "$raw" >/dev/null; then
			REJECT_WORD=unsupported
			ATTR_PATH=$path/charge_types
			ATTR_RAW=$raw
			return 0
		fi
	done

	REJECT_WORD=unsupported
	if ((saw_readable_battery)); then
		REJECT_WORD=unknown
	fi
	return 1
}

# Report the resolution failure: the failure word on stdout for the read
# commands, which the panel and humans both parse it as.
reject() {
	if [[ $REJECT_WORD == unknown ]]; then
		printf 'unknown\n'
		return "$EXIT_UNKNOWN"
	fi
	printf 'unsupported\n'
	return "$EXIT_UNSUPPORTED"
}

# Print the battery's charge types, one per line, the active one in
# [brackets]. Unprivileged: the attribute is world-readable.
cmd_list() {
	local name

	attr_path || reject

	# The kernel emits the list space-separated on one line; the contract is
	# one type per line, so split it.
	# Intentional word splitting: each entry of the just-read list.
	# shellcheck disable=SC2086
	for name in $ATTR_RAW; do
		printf '%s\n' "$name"
	done
	return "$EXIT_OK"
}

# Print the active charge type name alone, one word. Unprivileged.
cmd_status() {
	attr_path || reject

	active_name "$ATTR_RAW"
	return "$EXIT_OK"
}

# Print the listed entry of a charge_types read whose name (brackets stripped)
# equals $2, or fail. The kernel reads out the underscore form, so the listed
# entry is the canonical form to write.
list_member() {
	local raw=$1 want=$2 name

	# Intentional word splitting: the entries of the just-read list.
	# shellcheck disable=SC2086
	for name in $raw; do
		name=${name#\[}
		name=${name%\]}
		if [[ $name == "$want" ]]; then
			printf '%s\n' "$name"
			return 0
		fi
	done
	return 1
}

# Write the requested charge type. Requires already being root.
cmd_set() {
	local value=$1 canonical confirm active

	# Normalize: trim, and map spaces to underscores. The kernel accepts both
	# "Long Life" and "Long_Life" on write but reads emit the underscore form,
	# so the dual-variant tolerance is absorbed here, and the helper writes
	# exactly the form the list spells it.
	value=${value//[[:space:]]/_}
	while [[ $value == _* ]]; do value=${value#_}; done
	while [[ $value == *_ ]]; do value=${value%_}; done

	# Validation against the list just read, before a byte is written. The
	# whole surface: non-empty, and a member of the battery's own list.
	attr_path || {
		if [[ $REJECT_WORD == unknown ]]; then
			die "the battery's charge_types list has no single active entry; cannot set a charge type" "$EXIT_UNKNOWN"
		fi
		die "no usable charge_types attribute found; this battery offers no charge-type control" "$EXIT_UNSUPPORTED"
	}

	[[ -n $value ]] || die "refusing to write an empty charge type" "$EXIT_USAGE"
	canonical=$(list_member "$ATTR_RAW" "$value") ||
		die "refusing to write '$value': not among the types this battery offers" "$EXIT_USAGE"

	if ((EUID != 0)); then
		die "setting the charge type needs root. Run: pkexec $PACKAGED_PATH set $value" "$EXIT_USAGE"
	fi

	printf '%s' "$canonical" >"$ATTR_PATH" ||
		die "failed writing $ATTR_PATH" "$EXIT_ERROR"

	# Read it back rather than reporting success on the strength of a write
	# that returned zero. The kernel is free to keep the old value active.
	confirm=$(cat -- "$ATTR_PATH" 2>/dev/null) ||
		die "wrote $ATTR_PATH but cannot read it back" "$EXIT_ERROR"

	if ! active=$(active_name "$confirm"); then
		die "wrote '$canonical' to $ATTR_PATH but the read-back names no active type" "$EXIT_ERROR"
	fi

	if [[ $active != "$canonical" ]]; then
		die "wrote '$canonical' to $ATTR_PATH but it reads back with '$active' active" "$EXIT_ERROR"
	fi

	printf '%s\n' "$canonical"
	return "$EXIT_OK"
}

main() {
	case ${1-} in
	list)
		(($# == 1)) || die "list takes no arguments" "$EXIT_USAGE"
		cmd_list
		;;
	status)
		(($# == 1)) || die "status takes no arguments" "$EXIT_USAGE"
		cmd_status
		;;
	set)
		(($# == 2)) || die "set takes exactly one argument, the charge type name" "$EXIT_USAGE"
		cmd_set "$2"
		;;
	*)
		die "usage: ${0##*/} list | ${0##*/} status | ${0##*/} set <type>" "$EXIT_USAGE"
		;;
	esac
}

main "$@"
