#!/usr/bin/env bash
#
# Merge the first-party omarchy.power plugin into this fork.
#
# A panel builds its own contents inline and offers no API for another plugin to
# add a section to one, so omarchy.clonedFrom is the only supported way to change
# a built-in panel, and it replaces the original rather than layering on top. This
# repository is therefore a copy of shell/plugins/panels/power/ with our own
# additions, and staying in step with upstream is the only real cost of that.
#
# Not `git rebase`: the shell only finds a plugin whose manifest.json sits at the
# top level of ~/.config/omarchy/plugins/<id>/, so Panel.qml has to be at the
# root of this repository, while upstream keeps the same file under
# shell/plugins/panels/power/. Git can only merge paths that exist on both sides,
# so there is no shared ancestor to rebase onto.
#
# So the merge is done by hand, against the commit pinned in upstream.lock: ours,
# the pinned base, and the current upstream tip. Changes that do not overlap
# combine on their own; only real conflicts stop for you. Development-time only,
# the installed plugin never runs this.
#
# --check says where each tracked file stands and changes nothing. --diff prints
# this fork's changes as a patch against the pinned base. Both can be combined.
#
# Usage: tools/sync-upstream [--check] [--diff]

set -euo pipefail

readonly TRACKED=(Panel.qml Model.js manifest.json)
readonly LOCK_NAME=upstream.lock

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() {
	printf 'sync-upstream: %s\n' "$*" >&2
	exit 1
}

note() {
	printf '%s\n' "$*"
}

# How many lines differ between two files. grep exits 1 when nothing differs,
# which is not an error here.
changed_lines() {
	diff -u "$1" "$2" | grep -c '^[+-][^+-]' || true
}

# ---------------------------------------------------------------------------
# upstream.lock
# ---------------------------------------------------------------------------

# The value of one key, e.g. lock_value sha -> 0260d2ac...
lock_value() {
	local key=$1 line
	line=$(grep -m1 "^${key}=" "$LOCK_NAME" || true)
	[[ -n $line ]] || die "$LOCK_NAME has no '$key=' entry"
	printf '%s' "${line#*=}"
}

pin_lock() {
	sed -i "s/^sha=.*/sha=$1/" "$LOCK_NAME"
}

# ---------------------------------------------------------------------------
# the upstream mirror
# ---------------------------------------------------------------------------

upstream_git() {
	git --git-dir "$MIRROR" "$@"
}

ensure_mirror() {
	if [[ ! -d $MIRROR ]]; then
		note "creating upstream mirror at $MIRROR"
		git init --bare --quiet "$MIRROR"
		upstream_git remote add origin "$UPSTREAM_REPO"
		return
	fi

	# A mirror cached from an earlier repo= keeps fetching that repo, so editing
	# repo= in the lock would silently do nothing for anyone who already has one.
	local existing
	existing=$(upstream_git remote get-url origin 2>/dev/null || true)
	if [[ $existing != "$UPSTREAM_REPO" ]]; then
		die "the mirror at $MIRROR points at '${existing:-<none>}', but the lock says repo=$UPSTREAM_REPO. Point it there yourself with 'git --git-dir=$MIRROR remote set-url origin $UPSTREAM_REPO', or delete the mirror to have it recreated. (OMARCHY_UPSTREAM_MIRROR names a different path.)"
	fi
}

fetch_upstream() {
	# --filter=blob:none keeps the mirror at a few MB; git fetches the file blobs
	# on demand when we `git show` them below. An explicit refspec is used so
	# origin/$UPSTREAM_BRANCH exists afterwards whatever refspec the mirror's
	# remote was configured with: with a bare branch name git only updates a
	# remote-tracking ref when the refspec maps it, and a --mirror mirror's does not.
	upstream_git fetch --quiet --filter=blob:none origin \
		"+refs/heads/$UPSTREAM_BRANCH:refs/remotes/origin/$UPSTREAM_BRANCH" ||
		die "could not fetch $UPSTREAM_BRANCH from $UPSTREAM_REPO. Check the branch name against 'git ls-remote --heads $UPSTREAM_REPO': it should be the release branch for the omarchy you have installed, not omarchy's development branch."

	# The pinned base may be older than this mirror's history, and without it
	# there is no common ancestor to merge against.
	if ! upstream_git cat-file -e "${BASE_SHA}^{commit}" 2>/dev/null; then
		note "fetching pinned base ${BASE_SHA:0:7}"
		upstream_git fetch --quiet origin "$BASE_SHA" ||
			die "pinned base ${BASE_SHA:0:7} is not fetchable, so there is nothing to merge against. Upstream may have rewritten history."
	fi

	TIP_SHA=$(upstream_git rev-parse "origin/$UPSTREAM_BRANCH")
}

# One tracked file, out of the omarchy tree at a given commit.
upstream_file() {
	local sha=$1 name=$2
	upstream_git show "$sha:$UPSTREAM_PATH/$name" ||
		die "upstream has no $UPSTREAM_PATH/$name at ${sha:0:7}"
}

# ---------------------------------------------------------------------------
# installed omarchy vs the lock
# ---------------------------------------------------------------------------

# The lock's branch names the release for the omarchy this machine runs, so say
# so when it does not: "update omarchy first, then merge" is only enforceable if
# the tool knows which side of that swap you are on. Warns rather than dies, since
# the point is to catch a stale lock, not to make an older omarchy unsyncable, and
# stays quiet off-box where there is no omarchy to compare against.
installed_branch() {
	local version

	version=$(pacman -Q omarchy 2>/dev/null | awk '{ print $2 }') || true
	if [[ -z $version ]]; then
		version=$(/usr/share/omarchy/bin/omarchy-version 2>/dev/null) || true
	fi
	[[ -n $version ]] || return 1

	# 4.0.4-1 -> v4-0-4. The pkgrel is dropped and the dots become dashes.
	printf 'v%s\n' "${version%%-*}" | tr . -
}

check_lock_matches_install() {
	local installed

	installed=$(installed_branch) || return 0

	if [[ $installed != "$UPSTREAM_BRANCH" ]]; then
		note "WARNING: the lock tracks $UPSTREAM_BRANCH, but this machine has omarchy $installed installed, whose release branch is $installed."
		note "         Merging against $UPSTREAM_BRANCH brings in panel code that needs an omarchy this machine does not have."
		note "         Run 'omarchy update' first, then set branch=$installed in $LOCK_NAME and re-run. Nothing has been changed."
		note ""
	fi
}

# ---------------------------------------------------------------------------
# the two modes
# ---------------------------------------------------------------------------

# --check: say where each file stands, change nothing.
report() {
	local name
	for name in "${TRACKED[@]}"; do
		upstream_file "$BASE_SHA" "$name" >"$WORK/base"
		upstream_file "$TIP_SHA" "$name" >"$WORK/theirs"

		if cmp -s "$name" "$WORK/theirs"; then
			note "  $name: identical to upstream"
		elif cmp -s "$name" "$WORK/base"; then
			note "  $name: unmodified, upstream moved it $(changed_lines "$WORK/base" "$WORK/theirs") lines"
		else
			note "  $name: forked, $(changed_lines "$WORK/theirs" "$name") lines from upstream"
		fi
	done
}

# --diff: what this fork has changed, as a patch against the pinned base. The
# base is the point, not the tip: ours-minus-the-base is by definition this
# fork's own changes, and it stays meaningful when upstream has moved on, when
# it has not, and before any merge has run.
#
# Handed to git rather than diff(1) so paging and colour are git's problem: it
# pages and colours only when stdout is a terminal, so a redirected run yields a
# clean patch. One recursive diff over two populated directories rather than one
# per file, so a file that matches the base (Model.js, in practice) simply does
# not appear.
show_ours() {
	local base=upstream-${BASE_SHA:0:7} ours=ours name

	mkdir -p "$WORK/$base" "$WORK/$ours"
	for name in "${TRACKED[@]}"; do
		upstream_file "$BASE_SHA" "$name" >"$WORK/$base/$name"
		cp "$name" "$WORK/$ours/$name"
	done

	# Run from inside $WORK and name the directories relatively, because git
	# prints the path it was given: an absolute one would put the mktemp path in
	# every header. Empty prefixes drop the a/ b/ that would otherwise sit in
	# front of those, leaving `upstream-<sha>/Panel.qml` and `ours/Panel.qml`.
	# A subshell, so this does not move the repository out from under main().
	# --no-index is implied by git outside a work tree but required inside one,
	# which is where this runs.
	#
	# git exits 1 when there are differences, which is this mode's normal case
	# and not a failure.
	(
		cd "$WORK"
		git diff --no-index --src-prefix= --dst-prefix= "$base" "$ours" || true
	)
}

# merge: fold upstream into each tracked file. Records any file that conflicted
# in CONFLICTS so the caller can refuse to advance the pin.
merge() {
	local name status

	for name in "${TRACKED[@]}"; do
		upstream_file "$BASE_SHA" "$name" >"$WORK/base"
		upstream_file "$TIP_SHA" "$name" >"$WORK/theirs"

		# -L replaces the temp paths git merge-file would print, so a conflict
		# block reads as ours / the pinned base / current upstream.
		status=0
		git merge-file --diff3 \
			-L "ours ($name)" \
			-L "base (upstream ${BASE_SHA:0:7})" \
			-L "upstream ($UPSTREAM_BRANCH ${TIP_SHA:0:7})" \
			-p "$name" "$WORK/base" "$WORK/theirs" \
			>"$WORK/merged" || status=$?

		if ((status > 0)); then
			CONFLICTS+=("$name")
			note "  $name: $status conflict(s), markers written"
		else
			note "  $name: merged clean"
		fi

		mv "$WORK/merged" "$name"
	done
}

# After merging, show how far the fork still sits from upstream.
show_delta() {
	local name forked=0

	for name in "${TRACKED[@]}"; do
		upstream_file "$TIP_SHA" "$name" >"$WORK/theirs"
		if ! cmp -s "$name" "$WORK/theirs"; then
			forked=1
			note "  $name: $(changed_lines "$WORK/theirs" "$name") lines"
		fi
	done

	((forked)) || note "  none: this fork currently matches upstream exactly"
}

# ---------------------------------------------------------------------------

main() {
	local check_only=0 diff_only=0 arg stuck name

	for arg in "$@"; do
		case "$arg" in
		--check) check_only=1 ;;
		--diff) diff_only=1 ;;
		-h | --help)
		# Print this file's header comment, so the usage text cannot drift out of
		# sync with the code implementing it. Stops at the first line after the
		# shebang that is not a comment.
			awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
			return 0
			;;
		*)
			die "unknown option '$arg' (try --check or --diff)"
			;;
		esac
	done

	REPO=$(git rev-parse --show-toplevel) ||
		die "not inside a git repository. Run this from a checkout of the plugin."
	cd "$REPO"

	BASE_SHA=$(lock_value sha)
	UPSTREAM_PATH=$(lock_value path)
	UPSTREAM_REPO=$(lock_value repo)
	UPSTREAM_BRANCH=$(lock_value branch)

	# Scratch state is disposable. Set OMARCHY_UPSTREAM_MIRROR to keep it.
	MIRROR=${OMARCHY_UPSTREAM_MIRROR:-${TMPDIR:-/tmp}/omarchy-power-lenovo-battery-conservation-upstream.git}
	WORK=$(mktemp -d)
	trap 'rm -rf "$WORK"' EXIT

	CONFLICTS=()

	ensure_mirror
	fetch_upstream

	check_lock_matches_install

	note "base     $BASE_SHA"
	note "upstream $TIP_SHA ($UPSTREAM_BRANCH)"
	note ""

	if [[ $BASE_SHA == "$TIP_SHA" ]]; then
		note "Already up to date with $UPSTREAM_BRANCH."
		# Still worth reporting: "what has this fork changed?" is the question
		# --check and --diff exist to answer, and there is nothing new to merge
		# here.
		if ((check_only)); then
			note ""
			report
		fi
		if ((diff_only)); then
			note ""
			show_ours
		fi
		return 0
	fi

	if ! upstream_git merge-base --is-ancestor "$BASE_SHA" "$TIP_SHA"; then
		die "the pinned base ${BASE_SHA:0:7} is no longer an ancestor of $UPSTREAM_BRANCH, so there is nothing to merge against. $UPSTREAM_REPO was rebased or rewritten, or branch= now names a branch that diverged from the pinned base. Reconcile by hand, then point 'sha=' in $LOCK_NAME at a commit on $UPSTREAM_BRANCH."
	fi

	note "upstream changes to $UPSTREAM_PATH since the pinned base:"
	upstream_git diff --stat "$BASE_SHA" "$TIP_SHA" -- "$UPSTREAM_PATH"
	note ""

	if ((check_only || diff_only)); then
		if ((check_only)); then
			report
		fi
		if ((diff_only)); then
			if ((check_only)); then
				note ""
			fi
			show_ours
		fi
		return 0
	fi

	# Merging on top of leftover markers would nest a second set inside the
	# first, so make the caller clear them first.
	stuck=$(grep -l '^<<<<<<<' "${TRACKED[@]}" 2>/dev/null | tr '\n' ' ' || true)
	if [[ -n $stuck ]]; then
		die "these files still contain conflict markers from an earlier run, so merging again would nest another set inside them: ${stuck% } Resolve them (or git checkout them to start over), then re-run."
	fi

	# Unbalanced fork markers would merge into the file and only surface later
	# in bin/check, so gate them here, the way the check above gates conflict markers.
	for name in "${TRACKED[@]}"; do
		awk '
			/lenovo-conservation: start/ { depth++; next }
			/lenovo-conservation: end/ { if (depth == 0) exit 1; depth-- }
			END { if (depth != 0) exit 1 }
		' "$name" ||
			die "$name has unbalanced fork markers - a 'lenovo-conservation: start' without its 'end', or an 'end' with no start. Balance them, then re-run."
	done

	merge

	if ((${#CONFLICTS[@]})); then
		# Leave the pin alone: a re-run after resolving must merge from the same
		# base, and will come back clean once the resolution matches it.
		note ""
		note "Resolve by hand (<<< ours, ||| base, >>> upstream), commit, then re-run to re-pin:"
		printf '  %s\n' "${CONFLICTS[@]}"
		return 1
	fi

	pin_lock "$TIP_SHA"

	note ""
	note "pinned to $TIP_SHA. This fork's remaining delta from upstream:"
	show_delta
	note ""
	note "Review with git diff, then commit."
}

main "$@"
